{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/exemplos/barbearia-move/",
      "destination": "/exemplos/barbearia-move",
      "permanent": true
    },
    {
      "source": "/:rota(termos-de-uso|politica-de-privacidade|obrigado)/",
      "destination": "/:rota",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/termos-de-uso",
      "destination": "/termos-de-uso/index.html"
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/politica-de-privacidade/index.html"
    },
    {
      "source": "/obrigado",
      "destination": "/obrigado/index.html"
    },
    {
      "source": "/exemplos/barbearia-move",
      "destination": "/exemplos/barbearia-move/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
